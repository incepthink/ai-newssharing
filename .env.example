# OpenAI — used for article extraction (title/district/language) and 60-word summaries
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna

# Postgres (AWS RDS). Format:
#   postgres://USER:PASSWORD@HOST.rds.amazonaws.com:5432/DBNAME
DATABASE_URL=postgres://newsroom:password@localhost:5432/newsroom

# Connections per warm serverless instance. Keep low — RDS counts every one
# against max_connections. Raise only if you front RDS with RDS Proxy.
PG_POOL_MAX=3

# Paste the AWS RDS CA bundle PEM here to verify TLS properly. If unset, the
# connection is still encrypted but the certificate is not verified.
# RDS_CA_CERT=

# Set to "disable" for a plaintext local Postgres (never for RDS).
# DATABASE_SSL=disable

# Public base URL — used to build the per-article DOCX links in WhatsApp messages
NEXT_PUBLIC_BASE_URL=http://localhost:3000
